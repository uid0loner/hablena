{
  // Cloudflare Worker: serves the static site from ./dist and the API under /api/*.
  // Build command: npm run build
  // Deploy command: npx wrangler d1 migrations apply hablena --remote && npx wrangler deploy
  //
  // Pronunciation audio: provider and voice are set below in "vars".
  // The API key is a Cloudflare secret (Worker → Settings → Variables and Secrets → TTS_API_KEY),
  // never in this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hablena",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "TTS_PROVIDER": "elevenlabs",
    "TTS_VOICE": "LudcwvHIZaqQOcQfVZSY"
  },
  "keep_vars": true,
  "routes": [
    { "pattern": "hablena.com", "custom_domain": true },
    { "pattern": "www.hablena.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hablena",
      "database_id": "b521cf23-d2c0-497f-8872-8251d42abb9f",
      "migrations_dir": "migrations"
    }
  ]
}
