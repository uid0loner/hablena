{
  // Cloudflare Worker: serves the static site from ./dist and the API under /api/*.
  // Build command: npm run build
  // Deploy command: npx wrangler d1 migrations apply hablena --remote && npx wrangler deploy
  //
  // Pronunciation audio: voices are set in src/config/voices.json (one per speaker).
  // API keys are Cloudflare secrets (Worker → Settings → Variables and Secrets), never in this file:
  //   TTS_API_KEY (ElevenLabs), optional AZURE_TTS_KEY (Azure Speech), GOOGLE_TTS_KEY (Google TTS).
  // The cron trigger below generates missing clips every 5 minutes; progress: /api/audio/status
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hablena",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    { "pattern": "hablena.com", "custom_domain": true },
    { "pattern": "www.hablena.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hablena",
      "database_id": "b521cf23-d2c0-497f-8872-8251d42abb9f",
      "migrations_dir": "migrations"
    }
  ]
}
